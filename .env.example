# ragfaith judge configuration (see integrations/proxy/README.md)
RFE_JUDGE_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Option 1 (default): GLM main judge, DeepSeek fallback judge
RFE_JUDGE_MAIN_MODEL=z-ai/glm-5.3-flash
RFE_JUDGE_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash

# Option 2: Ling 3.0 Flash main judge, GLM fallback judge (fastest/cheapest,
# but highest parse-error rate; GLM remains the accuracy-first default)
# RFE_JUDGE_MAIN_MODEL=inclusionai/ling-3.0-flash
# RFE_JUDGE_FALLBACK_MODEL=z-ai/glm-5.3-flash
